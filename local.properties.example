# Copy this file to local.properties (gitignored) and set sdk.dir.
# The app does not read any other property from this file.

# Android SDK location. Required.
# Linux command-line SDK (typical):
#   sdk.dir=/home/YOUR_USERNAME/Android/Sdk
# Android Studio on macOS (typical):
#   sdk.dir=/Users/YOUR_USERNAME/Library/Android/sdk
sdk.dir=/home/YOUR_USERNAME/Android/Sdk

# JDK: this project compiles with toolchain 17 (see app/build.gradle.kts).
# CI uses Temurin 17. Point JAVA_HOME at a JDK 17, or set
# org.gradle.java.home in ~/.gradle/gradle.properties (not in this file).
# The Waze token is pasted in the app Settings screen. It is not a build property.
